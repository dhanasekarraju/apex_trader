# Apex Trader — local / shared-VPS template
#
# On the VPS: ignore any old .env and start fresh from this file:
#   mv .env .env.bak.$(date +%Y%m%d) 2>/dev/null || true
#   cp .env.example .env
#   # then edit SECRET_KEY, Kite keys, INITIAL_CAPITAL
#
# Coexist ports: docs/VPS_COEXIST.md (API :8090, PG :5439, Redis :6389)

ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://apex:apex@postgres:5432/apex_trader
DATABASE_URL_SYNC=postgresql://apex:apex@postgres:5432/apex_trader
REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8080
SECRET_KEY=change-me-openssl-rand-hex-32
API_ACCESS_KEY=

PUBLIC_URL=http://127.0.0.1:8090
APP_BASE_PATH=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090

INITIAL_CAPITAL=100000
TRADING_MODE=paper
ENABLE_LIVE_EXECUTION=false
DEFAULT_BROKER=paper
GOLIVE_APPROVED=false

# MIS session — entries until session_end; forced flatten at square-off (IST)
AUTONOMOUS_SESSION_START=09:20
AUTONOMOUS_SESSION_END=15:15
MIS_SQUARE_OFF_ENABLED=true
MIS_SQUARE_OFF_TIME=15:15

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=

POSTGRES_PASSWORD=apex
