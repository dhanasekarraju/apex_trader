# Apex Trader — local / shared-VPS template (copy to .env)
# On the same VPS as rubaih + rubaih-greeks, see docs/VPS_COEXIST.md

ENV=development
LOG_LEVEL=INFO

# Inside docker compose these hostnames are overridden; for host-side tools use:
#   postgresql://apex:apex@127.0.0.1:5439/apex_trader
#   redis://127.0.0.1:6389/0
DATABASE_URL=postgresql+asyncpg://apex:apex@postgres:5432/apex_trader
DATABASE_URL_SYNC=postgresql://apex:apex@postgres:5432/apex_trader
REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
# Container listens on 8080; host publishes :8090 (see docker-compose.yml)
API_PORT=8080
SECRET_KEY=change-me-openssl-rand-hex-32
API_ACCESS_KEY=

# Direct VPS access (no nginx path). Domain deploy can set PUBLIC_URL + APP_BASE_PATH.
PUBLIC_URL=http://127.0.0.1:8090
APP_BASE_PATH=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090

INITIAL_CAPITAL=100000
TRADING_MODE=paper
ENABLE_LIVE_EXECUTION=false
DEFAULT_BROKER=paper

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=

POSTGRES_PASSWORD=apex
