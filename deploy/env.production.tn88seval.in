# =============================================================================
# Apex Trader — PRODUCTION template for tn88seval.in (4 GB VPS)
# Copy to .env on server:  cp deploy/env.production.tn88seval.in .env
# Then fill KITE_* and set INITIAL_CAPITAL to your real trading capital.
# NEVER commit .env with real secrets.
# =============================================================================

ENV=production
LOG_LEVEL=INFO

# ── Database (docker-compose overrides hostnames for containers) ─────────────
DATABASE_URL=postgresql+asyncpg://apex:apex@postgres:5432/apex_trader
DATABASE_URL_SYNC=postgresql://apex:apex@postgres:5432/apex_trader
REDIS_URL=redis://redis:6379/0
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# ── API / public URL ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
# Optional: set explicit dashboard API key (else derived from SECRET_KEY SHA256)
API_ACCESS_KEY=
PUBLIC_URL=https://tn88seval.in
APP_BASE_PATH=/apex
CORS_ALLOWED_ORIGINS=https://tn88seval.in,https://www.tn88seval.in

# ── Capital & risk (set INITIAL_CAPITAL to YOUR real Zerodha capital) ───────
INITIAL_CAPITAL=100000
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.5
MAX_WEEKLY_LOSS_PCT=3.0
MAX_MONTHLY_LOSS_PCT=5.0
MAX_MONTHLY_DRAWDOWN_PCT=5.0
MAX_PORTFOLIO_HEAT_PCT=4.0
MAX_CORRELATED_EXPOSURE_PCT=15.0
MAX_SECTOR_CONCENTRATION_PCT=20.0
MIN_CONFIDENCE_SCORE=72
MAX_OPEN_POSITIONS=8
CONSECUTIVE_LOSS_REDUCE=3
CONSECUTIVE_LOSS_HALT=5
HIGH_VOL_SIZE_MULTIPLIER=0.5
VOL_THRESHOLD_REDUCE=35.0
KELLY_CAP_FRACTION=0.25
MAX_ENTRY_DEVIATION_PCT=2.0
ENFORCE_SECTOR_CORRELATION_LIMITS=false

# ── Live trading ─────────────────────────────────────────────────────────────
TRADING_MODE=live
ENABLE_LIVE_EXECUTION=true
DEFAULT_BROKER=kite
GOLIVE_APPROVED=true
ENFORCE_MARKET_HOURS=true
CHAOS_GATE_ENFORCE=true
CHAOS_REPORT_MAX_AGE_HOURS=168

# ── Kite (no quotes around values) ───────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=https://tn88seval.in/apex/api/kite/callback
KITE_MARKET_PROTECTION=-1
KITE_EXCHANGE=NSE
KITE_PRODUCT=MIS
KITE_AUTOSLICE=true
KITE_STATIC_IP_CONFIRMED=true

# ── Market data ──────────────────────────────────────────────────────────────
MARKET_DATA_SOURCE=kite
MIN_DATA_QUALITY_SCORE=0.85
MAX_STALE_FEED_SECONDS=120

# ── Autonomous — dynamic trending + wider scan on 4 GB ─────────────────────
AUTONOMOUS_ENABLED=true
AUTONOMOUS_ALLOW_LIVE=true
AUTONOMOUS_AUTO_START=false
WATCHLIST_MODE=dynamic
WATCHLIST_FILE=data/watchlist.yaml
# Extra symbols always included in dynamic quote set (comma-separated)
WATCHLIST_SYMBOLS=
AUTONOMOUS_SESSION_START=09:20
AUTONOMOUS_SESSION_END=15:15
AUTONOMOUS_SCAN_INTERVAL_SEC=120
AUTONOMOUS_SYMBOL_COOLDOWN_SEC=300
AUTONOMOUS_INTER_SYMBOL_DELAY_SEC=1.0
AUTONOMOUS_MAX_SYMBOLS_PER_CYCLE=25
AUTONOMOUS_MAX_WATCHLIST_SIZE=80
AUTONOMOUS_UNIVERSE_POOL_SIZE=80
AUTONOMOUS_UNIVERSE_MAX_QUOTES=150
AUTONOMOUS_UNIVERSE_MIN_PRICE=30
AUTONOMOUS_UNIVERSE_MIN_VOLUME=40000
# Small capital (~₹4–5k): cap scan universe to affordable names (0 = no cap)
AUTONOMOUS_UNIVERSE_MAX_PRICE=0

# ── Background loops (full suite) ───────────────────────────────────────────
LIFECYCLE_POLL_SEC=5.0
CONTROL_REFRESH_SEC=3.0
UI_POLL_INTERVAL_SEC=3.0

# ── Timeouts & ops ───────────────────────────────────────────────────────────
EXTERNAL_API_TIMEOUT_SEC=15.0
ANALYZE_TIMEOUT_SEC=12.0
EXECUTE_TIMEOUT_SEC=45.0
API_FAILURE_THRESHOLD=5
API_CIRCUIT_PAUSE_MINUTES=10
IDEMPOTENCY_BUCKET_MINUTES=5
LOG_DIR=data/logs

# ── ICB ────────────────────────────────────────────────────────────────────
ICB_TIMEOUT_SEC=25.0
ICB_MAX_TRADES_PER_HOUR=20
ICB_TRADE_WINDOW_MINUTES=60
ICB_DRIFT_RESTRICT_THRESHOLD=1
ICB_HEAT_DEGRADE_PCT=3.0
ICB_DEGRADED_SIZE_MULTIPLIER=0.5
ICB_AUTONOMOUS_BUY_SPIKE=8

# ── Strategy lab ─────────────────────────────────────────────────────────────
STRATEGY_DISABLE_WIN_RATE=35.0
STRATEGY_DISABLE_MIN_TRADES=20
ENABLE_NEWS_SENTIMENT=false

SYNC_CAPITAL_FROM_KITE=true
CAPITAL_SYNC_INTERVAL_SEC=300

# ── Alerts (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Unused on Kite-only deploy ─────────────────────────────────────────────
SHADOW_SLIPPAGE_BPS=3.0
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=
